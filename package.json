{
  "name": "train-novel",
  "private": true,
  "description": "RTX 4090 上用 Unsloth 对 Qwen3.5-4B / 9B 做 bf16 LoRA，学自己长篇的文风，按命题写整章",
  "scripts": {
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File start.ps1",
    "env:setup": "powershell -NoProfile -ExecutionPolicy Bypass -File setup.ps1",
    "env:check": "pixi run --locked check-env",
    "dashboard": "pixi run --locked dashboard",
    "data": "pixi run --locked data",
    "data:check": "pixi run --locked data-check",
    "write": "pixi run --locked write",
    "web:install": "pnpm -C web install",
    "web:dev": "pnpm -C web dev",
    "build": "pnpm -C web build",
    "lint": "pnpm -C web lint && pixi run --locked lint && pnpm data:check"
  },
  "packageManager": "pnpm@11.21.0"
}
