{
  "name": "novel-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "lint": "pnpm type-check && pnpm lint:ts && pnpm lint:style && pnpm lint:lobe",
    "lint:lobe": "node scripts/lint-lobe.mjs src",
    "lint:style": "stylelint \"src/**/*.{ts,tsx}\" --fix",
    "lint:ts": "eslint src --fix",
    "prettier": "prettier -c --write \"src/**/*\" \"*.{mjs,json}\"",
    "type-check": "tsc -p . --noEmit"
  },
  "dependencies": {
    "@lobehub/charts": "6.0.0",
    "@lobehub/icons": "6.0.0",
    "@lobehub/ui": "6.0.1",
    "lucide-react": "^1.62.0",
    "motion": "^12.23.12",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@lobehub/lint": "2.1.5",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "eslint": "10.0.2",
    "prettier": "^3.9.10",
    "stylelint": "^16.26.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.3"
  },
  "packageManager": "pnpm@11.21.0"
}
